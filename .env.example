# ============================================================
# Telangana Yogasana Sports Championship Portal - Environment Template
# Copy this file to .env and configure your values.
# ============================================================

# Application Runtime Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local Instance)
MONGO_URI=mongodb://127.0.0.1:27017/telangana_yoga

# JSON Web Token Secret (Provide a long, high-entropy secret, minimum 32 characters)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET

# Optional: Default password for seeded administrator accounts
SEED_DEFAULT_PASS=

# Optional: Custom Public Asset / CDN Base URL for Uploaded Documents (Defaults to /uploads)
STORAGE_BASE_URL=/uploads
